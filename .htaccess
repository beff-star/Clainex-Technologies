Options -Indexes

RewriteEngine On
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(?:database|includes)(?:/|$) - [F,L]
RewriteRule ^uploads/.*\.(?:php[0-9]?|phtml|phar)$ - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^(?:\.env(?:\..*)?|.*\.(?:sql|ini|log|bak|dist))$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Cache-Control "no-store, private"

    <FilesMatch "\.(?:css|js|jpe?g|png|gif|svg|webp|ico|woff2?)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
